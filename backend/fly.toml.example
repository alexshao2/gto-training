# Fly.io configuration for poker-gto-coach backend
# `flyctl deploy` from this directory.
app = "poker-gto-coach"
primary_region = "iad"

[build]

[env]
  PORT = "8080"
  # Set non-secret defaults here. Secrets (API keys) are managed via
  # `flyctl secrets set OPENAI_API_KEY=... OPENAI_BASE_URL=... OPENAI_MODEL=...`
  # See README for details.

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
  cpus = 1
