# LLM coach (optional - rule-based fallback if absent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Custom OpenAI-compatible endpoint (e.g. internal proxy). Leave default for OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1

# Text-to-speech model exposed via `${OPENAI_BASE_URL}/audio/speech`. Reuses
# OPENAI_API_KEY. Leave default for the user's proxy that supports google-tts/vi.
TTS_MODEL=google-tts/vi

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app,https://web.telegram.org
